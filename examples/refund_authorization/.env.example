# Copy to .env (git-ignored) and fill in. Never commit real keys.
# One organization API key with scopes ai-systems:write + agents:invoke + audit:read
# (Configure > Integrations > API keys)
PRAESIDIA_API_KEY=
PRAESIDIA_ORG_ID=
PRAESIDIA_AGENT_ID=
# Optional; defaults to https://api.praesidia.ai
PRAESIDIA_BASE_URL=
# Stripe TEST-mode secret key only (sk_test_...); anything else is refused (exit 2)
STRIPE_SECRET_KEY=
# A test-mode charge of exactly EUR 8,250.00 (ch_...)
STRIPE_CHARGE_ID=
# Optional; fill in the printed verify command. The Praesidia platform public key (PEM)
# and its SHA-256 fingerprint, obtained from Praesidia over a channel independent of the
# package. Never use the verifier's sample key or its fingerprint for a real package.
PRAESIDIA_PLATFORM_KEY_FILE=
PRAESIDIA_PLATFORM_KEY_FINGERPRINT=
